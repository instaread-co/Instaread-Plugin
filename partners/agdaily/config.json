{
  "partner_id": "agdaily",
  "domain": "agdaily.com",
  "publication": "agdaily",
  "injection_context": "post",
  "injection_strategy": "first",
  "force_disable_logs": true,
  "clear_page_cache_on_upgrade": true,
  "enqueue_remote_player_script_sitewide": true,
  "min_php_version": "5.6",
  "slot_heights": {
    "mobile": 236,
    "desktop": 236
  },
  "enable_footer_js_fallback": true,
  "footer_js_fallback_selector": [
    ".article-content p",
    ".col-sm-8.article-content p",
    ".article-content",
    ".single-article"
  ],
  "injection_rules": [
    {
      "target_selector": ".article-content p",
      "insert_position": "before_element",
      "exclude_slugs": [
        "/",
        "/privacy-policy/",
        "/terms-of-service/",
        "/terms-of-use/",
        "/about/",
        "/about-us/",
        "/contact/",
        "/contact-us/",
        "/advertise/",
        "/advertise-with-us/",
        "/authors/",
        "/shop/",
        "/cart/",
        "/checkout/",
        "/my-account/"
      ]
    }
  ],
  "version": "4.7.19"
}
